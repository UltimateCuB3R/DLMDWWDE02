<?xml version="1.0"?>
<TABLES>
    <TABLE name="game_state">
        <column name="game-id" dtype="int64"/>
        <column name="away" dtype="str"/>
        <column name="home" dtype="str"/>
        <column name="Stadium" dtype="str"/>
        <column name="Date" dtype="str"/>
        <column name="Location" dtype="str"/>
        <column name="Umpires" dtype="str"/>
        <column name="inning" dtype="str"/>
        <column name="out" dtype="int64"/>
        <column name="count" dtype="str"/>
        <column name="runner-1" dtype="str"/>
        <column name="runner-2" dtype="str"/>
        <column name="runner-3" dtype="str"/>
        <column name="away-score" dtype="int64"/>
        <column name="home-score" dtype="int64"/>
        <column name="pitcher" dtype="str"/>
        <column name="game-running" dtype="bool"/>
    </TABLE>
    <TABLE name="innings">
        <column name="game-id" dtype="int64"/>
        <column name="inning" dtype="str"/>
        <column name="batting-team" dtype="str"/>
        <column name="pitching-team" dtype="str"/>
        <column name="away-score" dtype="int64"/>
        <column name="home-score" dtype="int64"/>
        <column name="inning-running" dtype="bool"/>
    </TABLE>
</TABLES>